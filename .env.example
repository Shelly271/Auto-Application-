# JSearch (RapidAPI, free Basic plan)
RAPIDAPI_KEY=your-rapidapi-key

# Optional extra job sources for auto-apply; each is used only when its keys are set.
# Adzuna (free developer key: developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble (free key on request: jooble.org/api/about)
JOOBLE_API_KEY=

# Email (Gmail: smtp.gmail.com, port 465, and an App Password). Used both to apply for jobs
# and to send each person their job alerts.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional tuning
MAX_EMAILS_PER_CV_PER_RUN=5
MAX_ALERTS_PER_CV_PER_RUN=10
